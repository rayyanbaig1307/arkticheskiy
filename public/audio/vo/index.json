{
 "captain_0": {
  "file": "captain_0.mp3",
  "who": "captain",
  "ru": "Добро пожаловать на мостик. Руками ничего не трогай... шучу. Хочешь порулить, бери штурвал.",
  "voice": "pM78bgjPVk0JXtaEnFoj",
  "model": "eleven_v4"
 },
 "captain_1": {
  "file": "captain_1.mp3",
  "who": "captain",
  "ru": "Лёд сегодня тяжёлый. Держим средний ход, не торопимся.",
  "voice": "pM78bgjPVk0JXtaEnFoj",
  "model": "eleven_v4"
 },
 "captain_2": {
  "file": "captain_2.mp3",
  "who": "captain",
  "ru": "Тридцать лет хожу по Северу, а сияние до сих пор не надоело.",
  "voice": "pM78bgjPVk0JXtaEnFoj",
  "model": "eleven_v4"
 },
 "captain_3": {
  "file": "captain_3.mp3",
  "who": "captain",
  "ru": "Прожектор на крыше. Пульт справа от штурвала.",
  "voice": "pM78bgjPVk0JXtaEnFoj",
  "model": "eleven_v4"
 },
 "captain_4": {
  "file": "captain_4.mp3",
  "who": "captain",
  "ru": "Айсберги обходим, не таранить. Мы ледокол, а не дурак.",
  "voice": "pM78bgjPVk0JXtaEnFoj",
  "model": "eleven_v4"
 },
 "bosun_0": {
  "file": "bosun_0.mp3",
  "who": "bosun",
  "ru": "Не стой на линии троса! Лопнет — пополам разрежет.",
  "voice": "2Zst4rvX5S2nMbiauLDN",
  "model": "eleven_v4"
 },
 "bosun_1": {
  "file": "bosun_1.mp3",
  "who": "bosun",
  "ru": "Держись за поручни, качает.",
  "voice": "2Zst4rvX5S2nMbiauLDN",
  "model": "eleven_v4"
 },
 "bosun_2": {
  "file": "bosun_2.mp3",
  "who": "bosun",
  "ru": "Этот трос толще моей руки. И то, бывает, рвётся.",
  "voice": "2Zst4rvX5S2nMbiauLDN",
  "model": "eleven_v4"
 },
 "bosun_3": {
  "file": "bosun_3.mp3",
  "who": "bosun",
  "ru": "Видишь моржей на льдине? Здоровые, как бочки.",
  "voice": "2Zst4rvX5S2nMbiauLDN",
  "model": "eleven_v4"
 },
 "deckhand_0": {
  "file": "deckhand_0.mp3",
  "who": "deckhand",
  "ru": "Холодно сегодня, а? Минус тридцать, не меньше.",
  "voice": "Uv3rf12Omd9Asyv54Bqw",
  "model": "eleven_v4"
 },
 "deckhand_1": {
  "file": "deckhand_1.mp3",
  "who": "deckhand",
  "ru": "Первый рейс за полярный круг. Красиво, но пальцы не чувствую.",
  "voice": "Uv3rf12Omd9Asyv54Bqw",
  "model": "eleven_v4"
 },
 "deckhand_2": {
  "file": "deckhand_2.mp3",
  "who": "deckhand",
  "ru": "Говорят, пингвинов тут не бывает. А вон же они, сидят.",
  "voice": "Uv3rf12Omd9Asyv54Bqw",
  "model": "eleven_v4"
 },
 "deckhand_3": {
  "file": "deckhand_3.mp3",
  "who": "deckhand",
  "ru": "Кок обещал блины к утру.",
  "voice": "Uv3rf12Omd9Asyv54Bqw",
  "model": "eleven_v4"
 },
 "engineer_0": {
  "file": "engineer_0.mp3",
  "who": "engineer",
  "ru": "Двигатель работает как часы. Слышишь?",
